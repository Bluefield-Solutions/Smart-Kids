{
  "name": "smart-kids",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Erdkunde-Lernspiel fuer Fiona und Lea - Kontinente, Laender, Bundeslaender, Landeshauptstaedte",
  "scripts": {
    "geo-holen": "node tools/geo-holen.mjs",
    "backen": "node --max-old-space-size=6144 tools/backen-kontinente.mjs && node --max-old-space-size=6144 tools/backen-deutschland.mjs && node --max-old-space-size=6144 tools/backen-laender.mjs && node --max-old-space-size=4096 tools/backen-antarktika.mjs && node tools/backen-staedte.mjs",
    "schrift": "node tools/holen-schrift.mjs",
    "symbol": "node tools/backen-symbol.mjs && node tools/backen-symbol-png.mjs",
    "symbol:png": "node tools/backen-symbol-png.mjs",
    "bauen": "node entwuerfe/bauen.mjs && node prototyp/bauen.mjs",
    "prototyp": "node prototyp/bauen.mjs",
    "entwuerfe": "node entwuerfe/bauen.mjs",
    "inhalt": "node tor/inhalt.mjs",
    "doppelt": "node tor/doppelt.mjs",
    "vergleich": "node tor/vergleich.mjs",
    "ansicht": "node tor/ansicht.mjs",
    "pwa": "node tor/pwa.mjs",
    "smoke": "node tor/smoke.mjs",
    "tor": "node tools/kette.mjs",
    "tor:runner": "SMARTKIDS_OHNE_ANSICHT=1 npm run tor",
    "passt": "node tor/passt.mjs",
    "spielprobe": "node tor/spielprobe.mjs",
    "schreiben": "node tor/schreiben.mjs",
    "lesbarkeit": "node tor/lesbarkeit.mjs",
    "ziehen": "node tor/ziehen.mjs",
    "proben": "node tor/proben.mjs",
    "budget": "node tor/budget.mjs",
    "anker": "node tor/anker.mjs",
    "rhythmus": "node tor/rhythmus.mjs",
    "korpus": "node tools/korpus.mjs",
    "regeln": "node tor/regeln.mjs",
    "gleichlauf": "node tor/gleichlauf.mjs",
    "zweigeraete": "node tools/zwei-geraete.mjs",
    "dienstprobe": "node tools/dienstprobe.mjs",
    "ohneschrift": "node tools/ohne-schrift.mjs"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "mapshaper": "^0.6.102",
    "topojson-client": "^3.1.0"
  },
  "dependencies": {
    "playwright": "1.56.1",
    "pngjs": "^7.0.0"
  }
}
