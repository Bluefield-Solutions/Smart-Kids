node_modules/

# Das Gebaute. Entsteht bei jedem Lauf neu aus src/ - eingecheckt waere es
# eine zweite Wahrheit, die irgendwann von der ersten abweicht.
dist/

# Rohdaten gehoeren nicht ins Repository (79 MB gegen 1,2 MB gepackt).
# Sie werden mit tools/geo-holen.mjs beschafft; eingecheckt wird nur das
# gebackene Ergebnis in src/geo/.
roh/

# Antarktika wird von `npm run backen` erzeugt und von NIEMANDEM gelesen:
# `bauen.mjs` nimmt die Kontinente aus `kontinente.grob.js` und schliesst
# Antarktika dort ausdruecklich aus. Eingecheckt waere es ein Vorrat ohne
# Leser - drei Dateien, die bei jedem Backen wackeln und nichts beweisen.
src/geo/antarktika.*.js

# Ausschuss der Gegenprobe - entsteht bei jedem roten Lauf neu.
tor/abweichungen/

# Ebenfalls gebaut: die eine Datei zum Ansehen und die Daten der Entwuerfe.
# `npm run bauen` legt beide neu an.
prototyp/spiel.html
entwuerfe/daten.json
entwuerfe/schrift.css

# Was nach Pages geht: dist/ plus die Vorschau, von
# tools/seite-zusammenstellen.mjs bei jeder Auslieferung neu gebaut.
seite/
.zweigbaum/
.probenbaum/
.probenbaum*

# Was nur der Blick beurteilen kann: die Aufnahmen der Audit-Werkzeuge.
# Sie entstehen bei jedem Lauf neu und gehoeren nicht ins Verzeichnis.
blick/
.kette/
